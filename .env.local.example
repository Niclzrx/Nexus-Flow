# Fonte de dados: "mock" (padrão, sem backend) ou "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# Preencha ao migrar para Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas em ambiente de servidor (nunca expor no client). Usado em jobs/admin.
SUPABASE_SERVICE_ROLE_KEY=
